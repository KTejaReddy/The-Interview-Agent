# ============================================================================
# AI Interview Agent — backend environment
# Copy this file to backend/.env and fill in the values.
# Never commit .env files.
# ============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=AI Interview Agent
DEBUG=false
LOG_LEVEL=INFO

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Datasets ----------------------------------------------------------------
# Directory containing curriculum.json, candidate.json and technical-spec.md.
# Relative to the backend/ directory. These files are READ-ONLY for the app.
AI_DATA_DIR=./data

# --- Interview parameters -----------------------------------------------------
INTERVIEW_MIN_QUESTIONS=8
INTERVIEW_MIN_DAYS=4
INTERVIEW_TOTAL_QUESTIONS=12
INTERVIEW_MAX_FOLLOW_UPS=2
SESSION_TTL_SECONDS=7200
MAX_HISTORY_TURNS=12

# --- LLM provider (OpenAI-compatible) ------------------------------------------
# Leave LLM_API_KEY empty until you are ready; the app still boots and reports
# status via /api/health.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60

# Gemini (Google) also exposes an OpenAI-compatible endpoint. To use it:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.0-flash
#   LLM_API_KEY=<your Gemini API key>

# Set to true to run with a deterministic offline provider (no API key).
# For demos and tests only — never for production.
LLM_MOCK_MODE=false
# Set LLM_JSON_MODE=false for providers (like Gemini) that do not
# support the response_format parameter.
LLM_JSON_MODE=true
