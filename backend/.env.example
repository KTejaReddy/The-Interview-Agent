# ============================================================================
# AI Interview Agent — backend environment
# Copy this file to backend/.env and fill in the values.
# Never commit .env files.
# ============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=AI Interview Agent
DEBUG=false
LOG_LEVEL=INFO

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Datasets ----------------------------------------------------------------
# Directory containing curriculum.json, candidates.json (or candidate.json)
# and technical-spec.md. The app also finds them in backend/ or the project
# root. These files are READ-ONLY for the app.
AI_DATA_DIR=./data

# --- Interview parameters -----------------------------------------------------
INTERVIEW_MIN_QUESTIONS=8
INTERVIEW_MIN_DAYS=4
# Soft budget — the interview finishes here once the minimums are met and
# evidence is sufficient.  Keep it 8-10 so interviews feel concise.
INTERVIEW_TOTAL_QUESTIONS=10
# Absolute safety ceiling on main questions.
INTERVIEW_MAX_QUESTIONS=12
INTERVIEW_MAX_FOLLOW_UPS=2
SESSION_TTL_SECONDS=7200
MAX_HISTORY_TURNS=12

# --- LLM provider (OpenAI-compatible) ------------------------------------------
# Groq is the default (free, fast). Leave LLM_API_KEY empty until you are
# ready; the app still boots and reports status via /api/health.
LLM_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60

# Fallback models used when the primary is rate-limited or unavailable.
LLM_FALLBACK_MODELS=groq/compound,groq/compound-mini,qwen/qwen3-27b,openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant

# Gemini (Google) also exposes an OpenAI-compatible endpoint. To use it:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.0-flash
#   LLM_API_KEY=<your Gemini API key>
#   LLM_JSON_MODE=false

# Set to true to run with a deterministic offline provider (no API key).
# For demos and tests only — never for production.
LLM_MOCK_MODE=false
# Set LLM_JSON_MODE=false for providers (like Gemini) that do not
# support the response_format parameter.
LLM_JSON_MODE=true
